# =====================================================================
# Apsis Carbon - variaveis de ambiente (template)
# =====================================================================
# Copie este arquivo como .env (o .gitignore ja protege o .env) e preencha.
# Em producao as variaveis sao configuradas no painel do provedor de deploy,
# nunca commitadas com valor real.
#
# ---------------------------------------------------------------------
# DECISAO ARQUITETURAL: o frontend conhece SO DUAS variaveis.
# ---------------------------------------------------------------------
# As duas abaixo sao publicas por design (a anon key vive no bundle e e
# protegida por RLS no banco - e assim que o Supabase foi desenhado).
#
# TODO O RESTO da configuracao vive na tabela carbon_app_config do Supabase
# e chega ao navegador no boot, pela Edge Function publica "app-config":
#   GET {VITE_SUPABASE_URL}/functions/v1/app-config
# Isso inclui: clientId e tenantId do Azure AD, dominio de e-mail permitido,
# e-mail de suporte, imagens e textos da tela de login e feature flags.
# Vantagem: mudar qualquer um desses valores nao exige novo build/deploy do
# frontend, basta editar a linha em carbon_app_config (com publico = true).
#
# Segredos DE VERDADE (service_role key, chaves de integracao) existem
# SOMENTE como secrets das Edge Functions e nunca chegam ao navegador.
# NUNCA adicione uma VITE_..._SERVICE_KEY aqui: tudo que comeca com VITE_
# entra no bundle e fica visivel para qualquer usuario.
# ---------------------------------------------------------------------

# URL do projeto Supabase (Painel > Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anon/publishable do Supabase (publica, sujeita a RLS)
VITE_SUPABASE_ANON_KEY=COLE_A_ANON_KEY_AQUI

# ---------------------------------------------------------------------
# MODO DEMONSTRACAO (opcional, so para revisar o visual)
# ---------------------------------------------------------------------
# Com VITE_CARBON_DEMO=true o app sobe SEM Supabase: carregarConfig() nao faz
# rede e devolve a configuracao default, e a tela de login aparece normalmente
# com o botao da Microsoft DESABILITADO e o aviso "Modo demonstracao".
# Serve para revisar layout antes de o projeto Supabase existir.
#
# O modo demo so vale em desenvolvimento: ele exige
# import.meta.env.DEV && VITE_CARBON_DEMO === 'true'.
# Em build de producao (import.meta.env.PROD) e ignorado por forca, ou seja,
# nao existe risco de subir producao sem autenticacao por esquecer a flag.
VITE_CARBON_DEMO=false
